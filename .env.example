# Unihelp backend environment variables
# Copy this file to .env and fill values locally

PORT=5000
CLIENT_URL=
EMAIL_USER=
EMAIL_PASS=
RECEIVER_EMAIL=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash-latest

FLW_PUBLIC_KEY=
FLW_SECRET_HASH=
FLW_SECRET_KEY=

NEWS_DATA_API_KEY=
GNEWS_API_KEY=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT=

# Google Play backend-only secrets. Never expose these through Expo.
GOOGLE_PLAY_PACKAGE_NAME=com.zenithdev.unihelp
GOOGLE_PLAY_SUBSCRIPTION_PRODUCT_IDS=unihelp_premium_monthly,unihelp_premium_yearly
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_RTDN_TOKEN=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
